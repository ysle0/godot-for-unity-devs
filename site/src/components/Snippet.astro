---
// Shows code from a real file under godot/ or unity/, optionally cut to one
// `#region name` ... `#endregion` block (DESIGN.md §9, ADR-0002).
import { Code } from '@astrojs/starlight/components';

interface Props {
	/** Repository-root relative path, e.g. `godot/snippets/04-lifecycle/mover.gd`. */
	file: string;
	/** Name after `#region`. Omit to show the whole file without region markers. */
	region?: string;
	title?: string;
}

const REPO_ROOT = '../../../';
const sources = import.meta.glob<string>(
	['../../../godot/**/*.{gd,cs}', '../../../unity/**/*.cs'],
	{ query: '?raw', import: 'default', eager: true },
);

const REGION_START = /^\s*#region\s+(.+?)\s*$/;
const REGION_END = /^\s*#endregion\b/;
const LANGS: Record<string, string> = { gd: 'gdscript', cs: 'csharp' };

function dedent(lines: string[]): string {
	const indents = lines
		.filter((line) => line.trim() !== '')
		.map((line) => line.match(/^[\t ]*/)![0].length);
	const cut = indents.length ? Math.min(...indents) : 0;
	return lines.map((line) => line.slice(cut)).join('\n').trim();
}

function extract(source: string, region: string | undefined, file: string): string {
	const lines = source.replace(/\r\n/g, '\n').split('\n');
	if (region === undefined) {
		return dedent(lines.filter((line) => !REGION_START.test(line) && !REGION_END.test(line)));
	}
	const start = lines.findIndex((line) => REGION_START.exec(line)?.[1] === region);
	if (start < 0) throw new Error(`Snippet: region "${region}" not found in ${file}`);
	const body: string[] = [];
	let depth = 0;
	for (const line of lines.slice(start + 1)) {
		if (REGION_START.test(line)) {
			depth++;
			continue;
		}
		if (REGION_END.test(line)) {
			if (depth === 0) return dedent(body);
			depth--;
			continue;
		}
		body.push(line);
	}
	throw new Error(`Snippet: region "${region}" in ${file} has no #endregion`);
}

const { file, region, title } = Astro.props;
const source = sources[REPO_ROOT + file];
if (source === undefined) throw new Error(`Snippet: file not found: ${file}`);

const extension = file.split('.').pop() ?? '';
const lang = LANGS[extension] ?? extension;
const name = file.split('/').pop();
const illustrative = file.startsWith('unity/');
const code = extract(source, region, file);
---

<Code code={code} lang={lang} title={title ?? (illustrative ? `${name} · 설명용 코드` : name)} />
